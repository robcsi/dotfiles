#!/bin/sh
# Wayland renders alacritty at full DPI (looks larger); X11 shrinks via Xft.dpi=75.
# Match the smaller X11 size on Wayland only, without touching the shared config.
if [ "$XDG_SESSION_TYPE" = wayland ]; then
    exec /usr/bin/alacritty -o "font.size=8.5" "$@"
fi
exec /usr/bin/alacritty "$@"
